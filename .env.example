PORT=8080
TP_LOG_LEVEL=INFO

# Required for Tier-2 news.
TP_TIINGO_KEY=REPLACE_WITH_TIINGO_API_KEY

# Optional Tier-2 news fallbacks.
TP_MARKETAUX_KEY=
TP_ALPHAVANTAGE_KEY=
TP_FINNHUB_KEY=

# Optional Tier-3 LLM fallbacks.
TP_GROK_KEY=
TP_DEEPSEEK_KEY=
TP_OPENAI_KEY=
TP_PRIMARY_LLM=grok
TP_LLM_PROVIDER_ORDER=grok,deepseek,openai
TP_GROK_MODEL=grok-4.3
TP_DEEPSEEK_MODEL=deepseek-v4-pro
TP_OPENAI_MODEL=gpt-5.4-nano

# Auth defaults.
TP_AUTH_MODE=none
TP_AUTH_API_KEYS=
TP_JWT_SECRET=
TP_JWT_ISSUER=

# Runtime tuning defaults.
TP_CACHE_TTL=300
TP_RATE_LIMIT=100
TP_GLOBAL_RATE_LIMIT=1000
TP_PROVIDER_CALL_BUDGET_PER_REQUEST=6
TP_ONNX_THREADS=2
TP_MODEL_PATH=model.onnx
TP_REDIS_URL=redis://redis:6379
TP_EGRESS_ALLOWLIST=
